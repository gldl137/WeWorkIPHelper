# 本项目部署在 Linux（unraid），所有文本文件强制 LF，避免 Windows 检出时被转成 CRLF
# （CRLF 会让 unraid 上的 .sh 脚本报 “\r: command not found”）
* text=auto eol=lf

*.sh    text eol=lf
Dockerfile text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
