# 运行时数据目录（宿主机挂载，禁止进镜像）
data/
**/backend/data/
**/WW_verify/*.txt

# 脚本文件 (scripts/ 为本地启动用, 不进镜像)
scripts/
*.bat
*.ps1

# 前端源码 (构建产物已归位到 backend/static 与 backend/templates, 源码不进镜像)
frontend/
**/node_modules/

# 本地测试依赖目录 (pip --target 指定目录, 不进镜像)
**/pip-packages/
pip-packages/
.pip/

# Python 缓存与虚拟环境
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/venv/
**/env/

# 运行时 pid / 日志 / 临时文件
.run/
**/.run/
**/*.log
**/*.pid
**/*.bak
**/*.tmp

# buildx 本地配置（buildkitd.toml，由 build_push.sh 生成）
.buildx/

# 版本控制与编辑器
.git/
.gitignore
.vscode/
.idea/

# 文档
**/*.md

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
